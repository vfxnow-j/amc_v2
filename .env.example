# Copy to .env and fill in. Secrets never go in git.

# --- Database ---------------------------------------------------------------
# v2 runs alongside v1. Point this at a RESTORED COPY of the v1 database, not
# the live one — v2 exercises the same server actions and will write.
DATABASE_URL="postgresql://user:password@localhost:5432/vfxnow_amc_v2"

# --- Auth -------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3001"
AUTH_SECRET=""
# 32-byte key for the MFA secret at rest.
MFA_ENCRYPTION_KEY=""
# "on" asks for the second factor at sign-in. Anything else (including blank)
# makes sign-in email + password only — the state v2 runs in, because the
# restored users' TOTP secrets were encrypted under v1's key and there is no
# outbound email here to deliver a code. Temporary; see lib/mfa-enforcement.
AUTH_MFA=""

# --- App --------------------------------------------------------------------
APP_URL="http://localhost:3001"
# Bearer token guarding the /api/cron/* handlers.
CRON_SECRET=""

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=""
EMAIL_FROM=""

# --- QuickBooks -------------------------------------------------------------
# QB_ENVIRONMENT is "sandbox" or "production".
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="http://localhost:3001/api/quickbooks/callback"
QB_ENVIRONMENT="sandbox"
QUICKBOOKS_WEBHOOK_TOKEN=""

# --- Integrations -----------------------------------------------------------
# HubSpot / Zapier / JustCall inbound traffic.
PAYMENT_WEBHOOK_SECRET=""

# --- Calendar OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=""

# --- Market prices ----------------------------------------------------------
# SearXNG metasearch, behind Reports -> pricing. Nothing to do with AI.
SEARXNG_URL="http://localhost:8888"

# Not carried over from v1: OLLAMA_URL and LLM_MODEL — the AI assistant and its
# knowledge base are dropped in v2.
