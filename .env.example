# Copy to .env and fill in. Secrets never go in git.

# --- Database ---------------------------------------------------------------
# v2 runs alongside v1. Point this at a RESTORED COPY of the v1 database, not
# the live one — v2 exercises the same server actions and will write.
DATABASE_URL="postgresql://user:password@localhost:5432/vfxnow_amc_v2"

# --- Auth -------------------------------------------------------------------
NEXTAUTH_URL="http://localhost:3001"
AUTH_SECRET=""
# 32-byte key for the MFA secret at rest.
MFA_ENCRYPTION_KEY=""
# "on" asks for the second factor at sign-in. Anything else (including blank)
# makes sign-in email + password only — the state v2 runs in, because the
# restored users' TOTP secrets were encrypted under v1's key and there is no
# outbound email here to deliver a code. Temporary; see lib/mfa-enforcement.
AUTH_MFA=""

# --- App --------------------------------------------------------------------
# Also the base of every quote link mailed out. localhost is right for local
# work and wrong the moment anyone else has to open one — set it to the address
# the reader can actually reach (the LAN address, or the public host) before
# sending a quote to anybody.
APP_URL="http://localhost:3001"
# Bearer token guarding the /api/cron/* handlers.
CRON_SECRET=""

# --- Email (Resend) ---------------------------------------------------------
# Blank switches outbound email off: sendEmail and sendBatch report a refusal
# and every caller carries on. That is the normal state for this instance.
RESEND_API_KEY=""
# Must be an address on a domain verified in Resend, or Resend rejects the send.
# resend.dev's onboarding@resend.dev works without a domain, but only delivers
# to the Resend account holder's own address — enough to prove the wiring.
EMAIL_FROM=""

# While this is set, EVERY outbound email goes here instead of its real
# recipient, with the intended addressee in the subject and a banner in the
# body. Set it before putting a key in: this instance runs on restored data
# holding real client addresses and real staff notification recipients, so an
# unguarded key means one click mails an actual customer from a half-built app.
# Clear it only when v2 is meant to mail people for real.
EMAIL_TEST_REDIRECT=""
# Label put on every subject while this instance stands in for the live one ("AMC v2"). Blank = no label.
EMAIL_SUBJECT_TAG=""
# Public URL of the header logo for emails. Blank = a text wordmark (no attachment: vfxnow.com drops mail that has one).
EMAIL_LOGO_URL=""
# Comma list of addresses that always get their mail for real while the redirect is on (staff sign-in codes, resets).
EMAIL_DIRECT_ALLOW=""

# --- QuickBooks -------------------------------------------------------------
# QB_ENVIRONMENT is "sandbox" or "production".
QB_CLIENT_ID=""
QB_CLIENT_SECRET=""
QB_REDIRECT_URI="http://localhost:3001/api/quickbooks/callback"
QB_ENVIRONMENT="sandbox"
QUICKBOOKS_WEBHOOK_TOKEN=""

# --- Integrations -----------------------------------------------------------
# HubSpot / Zapier / JustCall inbound traffic.
PAYMENT_WEBHOOK_SECRET=""

# --- Calendar OAuth ---------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=""

# --- Market prices ----------------------------------------------------------
# SearXNG metasearch, behind Reports -> pricing. Nothing to do with AI.
SEARXNG_URL="http://localhost:8888"

# Not carried over from v1: OLLAMA_URL and LLM_MODEL — the AI assistant and its
# knowledge base are dropped in v2.

# Content-Security-Policy: report-only until set to "enforce" (see src/lib/csp.ts)
CSP_MODE=report-only
